{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeraBooks/bank-reconciliation-proof-of-cash/schema/bank-or-book-row.schema.json",
  "title": "Row of bank.csv or book.csv",
  "type": "object",
  "required": ["date", "ref", "description", "amount"],
  "properties": {
    "date": {"type": "string", "format": "date", "description": "bank.csv: the day the bank posted it. book.csv: the day it was recorded."},
    "ref": {"type": "string", "description": "Check number, or blank."},
    "description": {"type": "string"},
    "amount": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$", "description": "Money in positive, money out negative."}
  }
}
